{
  "name": "playwright-cli",
  "version": "1.0.0",
  "description": "CLI tool for Playwright browser automation - connect to existing instances or launch new ones",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "bin": {
    "playwright-cli": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build:bun": "bun build src/index.ts --compile --outfile pw-bun --external electron --external chromium-bidi",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:node": "echo '#!/usr/bin/env bash' > pw && echo 'DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"' >> pw && echo 'exec node \"$DIR/dist/src/index.js\" \"$@\"' >> pw && chmod +x pw",
    "build": "bun run build:ts && bun run build:node",
    "build:windows": "bun run build:ts && pkg dist/src/index.js --targets node18-win-x64 --output pw.exe",
    "build:linux": "bun run build:ts && pkg dist/src/index.js --targets node18-linux-x64 --output pw",
    "build:all": "bun run build:ts && pkg dist/src/index.js --targets node18-macos-arm64,node18-win-x64,node18-linux-x64 --output pw",
    "install:local": "bun run build && mkdir -p ~/.local/bin && cp pw ~/.local/bin/",
    "test": "PLAYWRIGHT_CLI_HEADLESS=true PORT=19222 bun test --preload ./src/test-utils/global-setup.ts --max-concurrency=1",
    "test:ci": "PLAYWRIGHT_CLI_HEADLESS=true PORT=19222 bun run test:shards",
    "test:shard:advanced": "bun test --preload ./src/test-utils/global-setup.ts src/yargs/commands/advanced/**/*.test.ts src/lib/**/*.test.ts",
    "test:shard:capture": "bun test --preload ./src/test-utils/global-setup.ts src/yargs/commands/capture/**/*.test.ts",
    "test:shard:interaction": "bun test --preload ./src/test-utils/global-setup.ts src/yargs/commands/interaction/**/*.test.ts",
    "test:shard:navigation": "bun test --preload ./src/test-utils/global-setup.ts src/yargs/commands/navigation/**/*.test.ts src/yargs/**/*.test.ts",
    "test:shard:utility": "bun test --preload ./src/test-utils/global-setup.ts src/yargs/commands/utility/**/*.test.ts src/test-utils/**/*.test.ts",
    "test:shards": "PLAYWRIGHT_CLI_HEADLESS=true PORT=19222 bun run test:shard:advanced && bun run test:shard:capture && bun run test:shard:interaction && bun run test:shard:navigation && bun run test:shard:utility",
    "test:coverage": "PLAYWRIGHT_CLI_HEADLESS=true PORT=19222 bun test --preload ./src/test-utils/global-setup.ts --coverage",
    "test:coverage:ci": "PLAYWRIGHT_CLI_HEADLESS=true PORT=19222 bun test --preload ./src/test-utils/global-setup.ts --coverage --bail=5",
    "test:watch": "PLAYWRIGHT_CLI_HEADLESS=true PORT=19222 bun test --preload ./src/test-utils/global-setup.ts --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "ci": "bun run typecheck && bun run lint && bun run format:check && bun run test:coverage",
    "semantic-release": "semantic-release"
  },
  "pkg": {
    "scripts": "dist/src/**/*.js",
    "targets": [
      "node18-macos-arm64",
      "node18-win-x64",
      "node18-linux-x64"
    ]
  },
  "dependencies": {
    "@types/yargs": "^17.0.33",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "playwright": "^1.48.0",
    "why-is-node-running": "^3.2.2",
    "yargs": "^17.7.2"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "latest",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.19.11",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint-plugin-import": "^2.32.0",
    "lint-staged": "^16.1.6",
    "pkg": "^5.8.1",
    "prettier": "^3.6.2",
    "semantic-release": "^22.0.12",
    "typescript": "^5.9.2",
    "winston": "^3.17.0"
  },
  "patchedDependencies": {
    "playwright-core@1.55.0": "patches/playwright-core@1.55.0.patch"
  }
}
